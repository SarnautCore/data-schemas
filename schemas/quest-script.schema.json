{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/quest-script.schema.json",
  "title": "SarnautCore quest script",
  "description": "The counter bindings, start impacts and trigger agents evaluated when one quest activates. Nodes use ADR 0036's open recursive representation, so an unfamiliar opcode remains valid and its tier decides whether it can execute.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "zone", "quest", "source_type", "_source"],
  "anyOf": [
    { "required": ["counters"] },
    { "required": ["start_impacts"] },
    { "required": ["trigger_agents"] }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^script(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$"
    },
    "zone": { "$ref": "common.schema.json#/$defs/zoneId" },
    "quest": {
      "type": "string",
      "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$"
    },
    "source_type": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "integer", "minimum": 0 },
    "counters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count_id", "objective", "objective_id"],
        "properties": {
          "count_id": {
            "type": "string",
            "pattern": "^questcount(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){3}$"
          },
          "objective": { "type": "integer", "minimum": 0 },
          "objective_id": {
            "description": "Stable semantic objective identity from M3-08. The positional objective field remains migration compatibility only.",
            "type": "string",
            "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}\\.objective\\.[0-9a-f]{64}$"
          },
          "href": { "type": "string", "minLength": 1 }
        }
      }
    },
    "start_impacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/impactNode" }
    },
    "trigger_agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/triggerNode" }
    },
    "extra": { "type": "object", "additionalProperties": true },
    "curation_note": { "$ref": "common.schema.json#/$defs/curationNote" },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  },
  "$defs": {
    "impactNode": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/scriptNode" },
        {
          "type": "object",
          "properties": { "family": { "const": "impact" } }
        }
      ]
    },
    "triggerNode": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/scriptNode" },
        {
          "type": "object",
          "properties": { "family": { "const": "trigger" } }
        }
      ]
    }
  }
}
