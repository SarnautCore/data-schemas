{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/player-progression.schema.json",
  "title": "SarnautCore player progression",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source_type", "max_level", "respawn_delay_ms", "resurrection_sickness_duration_ms", "thresholds", "experience_impacts", "_source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^progression(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" },
    "source_type": { "type": "string", "minLength": 1 },
    "max_level": { "type": "integer", "minimum": 1 },
    "respawn_delay_ms": { "type": "integer", "minimum": 0 },
    "resurrection_sickness_duration_ms": { "type": "integer", "minimum": 0 },
    "thresholds": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["level", "cumulative_experience"],
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "cumulative_experience": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "experience_impacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "mob_count", "mob_level", "resolved_experience"],
        "properties": {
          "id": { "type": "string", "pattern": "^impact(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" },
          "mob_count": { "type": "integer", "minimum": 0 },
          "mob_level": { "type": "integer", "minimum": 0 },
          "resolved_experience": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  }
}
