{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/quest.schema.json",
  "title": "SarnautCore quest",
  "description": "A quest definition. Quests are authored per zone, so this schema adds the zone field on top of the zone-free common base.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "zone", "source_type", "rewards", "_source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" },
    "zone": { "$ref": "common.schema.json#/$defs/zoneId" },
    "source_type": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "integer", "minimum": 0 },
    "internal_name": { "type": "string" },
    "loc_ref": { "$ref": "#/$defs/locRefs" },
    "level": { "type": "integer" },
    "required_level": { "type": "integer" },
    "quest_type": { "$ref": "common.schema.json#/$defs/slug" },
    "plotline": { "type": "string" },
    "starter": { "$ref": "common.schema.json#/$defs/resourceRef" },
    "finisher": { "$ref": "common.schema.json#/$defs/resourceRef" },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quest"],
        "properties": {
          "quest": { "$ref": "common.schema.json#/$defs/resourceRef" },
          "status": { "type": "string" }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective_id", "kind"],
        "properties": {
          "objective_id": {
            "type": "string",
            "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}\\.objective\\.[a-f0-9]{64}$"
          },
          "kind": { "$ref": "common.schema.json#/$defs/slug" },
          "loc_ref": { "$ref": "common.schema.json#/$defs/locKey" },
          "limit": { "type": "integer" },
          "internal": { "type": "boolean" },
          "show_count": { "type": "boolean" },
          "targets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/resourceRef" } },
          "extra": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience": { "type": "integer" },
        "money": { "type": "integer" },
        "honor": { "type": "integer" },
        "mandatory_items": { "$ref": "#/$defs/rewardItems" },
        "alternative_items": { "$ref": "#/$defs/rewardItems" },
        "reputations": { "type": "array", "items": true }
      }
    },
    "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "extra": { "type": "object", "additionalProperties": true },
    "curation_note": { "$ref": "common.schema.json#/$defs/curationNote" },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  },
  "$defs": {
    "locRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/locKey" },
        "goal": { "$ref": "common.schema.json#/$defs/locKey" },
        "start": { "$ref": "common.schema.json#/$defs/locKey" },
        "check": { "$ref": "common.schema.json#/$defs/locKey" },
        "finish": { "$ref": "common.schema.json#/$defs/locKey" }
      },
      "minProperties": 1
    },
    "rewardItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "count"],
        "properties": {
          "item": { "$ref": "common.schema.json#/$defs/resourceRef" },
          "count": { "type": "integer", "minimum": 0 },
          "hidden": { "type": "boolean" }
        }
      }
    }
  }
}
