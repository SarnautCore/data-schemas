{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/quest.schema.json",
  "title": "SarnautCore quest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "zone", "source_type", "rewards", "_source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" },
    "zone": { "type": "string", "pattern": "^zone\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source_type": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "integer", "minimum": 0 },
    "internal_name": { "type": "string" },
    "loc_ref": { "$ref": "#/$defs/locRefs" },
    "level": { "type": "integer" },
    "required_level": { "type": "integer" },
    "quest_type": { "$ref": "#/$defs/slug" },
    "plotline": { "type": "string" },
    "starter": { "$ref": "#/$defs/resourceRef" },
    "finisher": { "$ref": "#/$defs/resourceRef" },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quest"],
        "properties": {
          "quest": { "$ref": "#/$defs/resourceRef" },
          "status": { "type": "string" }
        }
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": { "$ref": "#/$defs/slug" },
          "loc_ref": { "type": "string" },
          "limit": { "type": "integer" },
          "internal": { "type": "boolean" },
          "show_count": { "type": "boolean" },
          "targets": { "type": "array", "items": { "$ref": "#/$defs/resourceRef" } },
          "extra": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experience": { "type": "integer" },
        "money": { "type": "integer" },
        "honor": { "type": "integer" },
        "mandatory_items": { "$ref": "#/$defs/rewardItems" },
        "alternative_items": { "$ref": "#/$defs/rewardItems" },
        "reputations": { "type": "array", "items": true }
      }
    },
    "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "extra": { "type": "object", "additionalProperties": true },
    "_source": { "$ref": "#/$defs/source" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
        "href": { "type": "string" }
      }
    },
    "locRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "goal": { "type": "string" },
        "start": { "type": "string" },
        "check": { "type": "string" },
        "finish": { "type": "string" }
      },
      "minProperties": 1
    },
    "rewardItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "count"],
        "properties": {
          "item": { "$ref": "#/$defs/resourceRef" },
          "count": { "type": "integer", "minimum": 0 },
          "hidden": { "type": "boolean" }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blake3", "extractor"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "extractor": { "type": "string", "pattern": "^sarnaut-extract@[0-9]+\\.[0-9]+\\.[0-9]+" }
      }
    }
  }
}
