{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/spawn.schema.json",
  "title": "SarnautCore spawn resource",
  "oneOf": [
    { "$ref": "#/$defs/table" },
    { "$ref": "#/$defs/mob" },
    { "$ref": "#/$defs/placements" }
  ],
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "canonicalId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["href"],
      "properties": {
        "id": { "$ref": "#/$defs/canonicalId" },
        "href": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "blake3", "extractor"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "extractor": { "type": "string", "pattern": "^sarnaut-extract@[0-9]+\\.[0-9]+\\.[0-9]+" }
      }
    },
    "base": {
      "type": "object",
      "required": ["schema_version", "id", "kind", "zone", "source_type", "_source"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/canonicalId" },
        "kind": { "enum": ["table", "mob", "placements"] },
        "zone": { "type": "string", "pattern": "^zone\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source_type": { "type": "string", "minLength": 1 },
        "_source": { "$ref": "#/$defs/source" }
      }
    },
    "table": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "source_type", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "table" },
            "zone": true,
            "source_type": true,
            "resource_id": { "type": "integer", "minimum": 0 },
            "scripted": { "type": "boolean" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["group", "object"],
                "properties": {
                  "group": { "$ref": "#/$defs/slug" },
                  "object": { "$ref": "#/$defs/resourceRef" },
                  "chance": { "type": "number" },
                  "spawn_time": { "$ref": "#/$defs/slug" },
                  "extra": { "type": "object", "additionalProperties": true }
                }
              }
            },
            "extra": { "type": "object", "additionalProperties": true },
            "_source": true
          }
        }
      ]
    },
    "mobLocRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" }
      },
      "minProperties": 1
    },
    "mob": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "source_type", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "mob" },
            "zone": true,
            "source_type": true,
            "resource_id": { "type": "integer", "minimum": 0 },
            "loc_ref": { "$ref": "#/$defs/mobLocRefs" },
            "visual_ref": { "type": "string" },
            "mob_kind": { "$ref": "#/$defs/resourceRef" },
            "faction": { "$ref": "#/$defs/resourceRef" },
            "quality": { "$ref": "#/$defs/resourceRef" },
            "level_min": { "type": "integer" },
            "level_max": { "type": "integer" },
            "walk_speed": { "type": "number" },
            "quests": { "type": "array", "items": { "$ref": "#/$defs/resourceRef" } },
            "abilities": { "type": "array", "items": { "$ref": "#/$defs/resourceRef" } },
            "extra": { "type": "object", "additionalProperties": true },
            "_source": true
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["yaw", "pitch", "roll"],
      "properties": {
        "yaw": { "type": "number" },
        "pitch": { "type": "number" },
        "roll": { "type": "number" }
      }
    },
    "placements": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "map", "source_type", "placements", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "placements" },
            "zone": true,
            "map": { "$ref": "#/$defs/slug" },
            "source_type": true,
            "placements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "object"],
                "properties": {
                  "id": { "$ref": "#/$defs/canonicalId" },
                  "script_id": { "type": "string" },
                  "object": { "$ref": "#/$defs/resourceRef" },
                  "position": { "$ref": "#/$defs/position" },
                  "orientation": { "$ref": "#/$defs/orientation" },
                  "route": { "$ref": "#/$defs/canonicalId" },
                  "tuner_ref": { "type": "string" },
                  "spawn_time": { "$ref": "#/$defs/slug" },
                  "scan_radius": { "type": "number" }
                },
                "anyOf": [
                  { "required": ["position"] },
                  { "required": ["route"] }
                ]
              }
            },
            "_source": true
          }
        }
      ]
    }
  }
}
