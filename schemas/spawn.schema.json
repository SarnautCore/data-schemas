{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/spawn.schema.json",
  "title": "SarnautCore spawn resource",
  "description": "Spawn tables, mob templates and placements. Every spawn document is scoped to exactly one zone, so this schema adds the zone field on top of the zone-free common base.",
  "oneOf": [
    { "$ref": "#/$defs/table" },
    { "$ref": "#/$defs/mob" },
    { "$ref": "#/$defs/placements" }
  ],
  "$defs": {
    "base": {
      "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
      "type": "object",
      "required": ["kind", "zone"],
      "properties": {
        "kind": { "enum": ["table", "mob", "placements"] },
        "zone": { "$ref": "common.schema.json#/$defs/zoneId" }
      }
    },
    "table": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "source_type", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "table" },
            "zone": true,
            "source_type": true,
            "resource_id": { "type": "integer", "minimum": 0 },
            "scripted": { "type": "boolean" },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["group", "object"],
                "properties": {
                  "group": { "$ref": "common.schema.json#/$defs/slug" },
                  "object": { "$ref": "common.schema.json#/$defs/resourceRef" },
                  "chance": { "type": "number" },
                  "spawn_time": { "$ref": "common.schema.json#/$defs/slug" },
                  "extra": { "type": "object", "additionalProperties": true }
                }
              }
            },
            "extra": { "type": "object", "additionalProperties": true },
            "_source": true
          }
        }
      ]
    },
    "mobLocRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/locKey" },
        "title": { "$ref": "common.schema.json#/$defs/locKey" }
      },
      "minProperties": 1
    },
    "mob": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "source_type", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "mob" },
            "zone": true,
            "source_type": true,
            "resource_id": { "type": "integer", "minimum": 0 },
            "loc_ref": { "$ref": "#/$defs/mobLocRefs" },
            "visual_ref": { "type": "string" },
            "mob_kind": { "$ref": "common.schema.json#/$defs/resourceRef" },
            "faction": { "$ref": "common.schema.json#/$defs/resourceRef" },
            "quality": { "$ref": "common.schema.json#/$defs/resourceRef" },
            "loot_table": { "$ref": "common.schema.json#/$defs/resourceRef" },
            "level_min": { "type": "integer" },
            "level_max": { "type": "integer" },
            "walk_speed": { "type": "number" },
            "quests": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/resourceRef" } },
            "abilities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/resourceRef" } },
            "extra": { "type": "object", "additionalProperties": true },
            "_source": true
          }
        }
      ]
    },
    "placements": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "id", "kind", "zone", "map", "source_type", "placements", "_source"],
          "properties": {
            "schema_version": true,
            "id": true,
            "kind": { "const": "placements" },
            "zone": true,
            "map": { "$ref": "common.schema.json#/$defs/slug" },
            "source_type": true,
            "placements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "object"],
                "properties": {
                  "id": { "$ref": "common.schema.json#/$defs/canonicalId" },
                  "script_id": { "type": "string" },
                  "object": { "$ref": "common.schema.json#/$defs/resourceRef" },
                  "position": { "$ref": "common.schema.json#/$defs/position" },
                  "orientation": { "$ref": "common.schema.json#/$defs/orientation" },
                  "route": { "$ref": "common.schema.json#/$defs/canonicalId" },
                  "tuner_ref": { "type": "string" },
                  "spawn_time": { "$ref": "common.schema.json#/$defs/slug" },
                  "scan_radius": { "type": "number" }
                },
                "anyOf": [
                  { "required": ["position"] },
                  { "required": ["route"] }
                ]
              }
            },
            "_source": true
          }
        }
      ]
    }
  }
}
