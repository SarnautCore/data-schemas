{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/item.schema.json",
  "title": "SarnautCore item",
  "description": "An item definition. Items are a ruleset-global resource: they carry no zone.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "category", "source_type", "_source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^item\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
    "category": { "$ref": "common.schema.json#/$defs/slug" },
    "source_type": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "integer", "minimum": 0 },
    "sys_name": { "type": "string", "minLength": 1 },
    "loc_ref": { "$ref": "#/$defs/itemLocRefs" },
    "image_ref": { "type": "string" },
    "visual_ref": { "type": "string" },
    "level": { "type": "integer" },
    "required_level": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "description": "Authored signed player-level gate. Classic 1.1 uses negative values for unrestricted items."
    },
    "quality": { "$ref": "common.schema.json#/$defs/resourceRef" },
    "slot": { "$ref": "common.schema.json#/$defs/slug" },
    "item_class": { "$ref": "common.schema.json#/$defs/resourceRef" },
    "item_category": { "$ref": "common.schema.json#/$defs/resourceRef" },
    "binding": { "$ref": "common.schema.json#/$defs/slug" },
    "stack_limit": { "type": "integer", "minimum": 0 },
    "curse_eligible": {
      "description": "Resolved result of the ruleset CursedItems.canBeCursed predicate for this item.",
      "type": "boolean"
    },
    "vendor_price": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sell": { "type": "integer" },
        "buy": { "type": "integer" }
      },
      "minProperties": 1
    },
    "stats": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/statEntry" }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armor": { "type": "number" },
        "min_damage": { "type": "number" },
        "max_damage": { "type": "number" },
        "weapon_speed": { "type": "number" },
        "spell_power": { "type": "number" },
        "damage_element": { "$ref": "common.schema.json#/$defs/slug" },
        "resist_divine": { "type": "number" },
        "resist_elemental": { "type": "number" },
        "resist_nature": { "type": "number" }
      },
      "minProperties": 1
    },
    "capacity": { "type": "integer", "minimum": 0 },
    "spell_ref": { "type": "string" },
    "flags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "extra": { "type": "object", "additionalProperties": true },
    "curation_note": { "$ref": "common.schema.json#/$defs/curationNote" },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  },
  "$defs": {
    "itemLocRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/locKey" },
        "description": { "$ref": "common.schema.json#/$defs/locKey" },
        "bind_description": { "$ref": "common.schema.json#/$defs/locKey" }
      },
      "minProperties": 1
    }
  }
}
