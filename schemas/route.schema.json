{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/route.schema.json",
  "title": "SarnautCore route",
  "description": "A patrol route. Routes are authored per zone, so this schema adds the zone field on top of the zone-free common base.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "zone", "map", "source_type", "points", "_source"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^route(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" },
    "zone": { "$ref": "common.schema.json#/$defs/zoneId" },
    "map": { "$ref": "common.schema.json#/$defs/slug" },
    "source_type": { "type": "string", "minLength": 1 },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "position"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "position": { "$ref": "common.schema.json#/$defs/position" },
          "script_ref": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "integer", "minimum": 0 },
          "to": { "type": "integer", "minimum": 0 },
          "weight": { "type": "number" },
          "movement": { "$ref": "common.schema.json#/$defs/slug" },
          "flying": { "type": "boolean" }
        }
      }
    },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  }
}
