{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarnautcore.org/chargen.schema.json",
  "title": "SarnautCore character creation option",
  "description": "One selectable character-creation option, per ADR 0032. Neither the client nor the server may hold a starting item, stat, ability or spawn coordinate in code, so every one of them is a field here. Options are global: a chargen document names the zone it spawns into but is not scoped to one. Options that are not playable yet ship with enabled:false rather than being absent, so enabling the next one is a data change CI has already been validating.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/base" }],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_type",
    "race",
    "class",
    "sex",
    "faction",
    "enabled",
    "visual_ref",
    "spawn",
    "starting_level",
    "_source"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^chargen\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$" },
    "source_type": { "type": "string", "minLength": 1 },
    "race": {
      "description": "Canonical race id. M2 has no race document type, so this is a taxonomy token rather than a reference the cross-reference pass resolves.",
      "type": "string",
      "pattern": "^race\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "class": {
      "description": "Canonical class id. As with race, M2 has no class document type.",
      "type": "string",
      "pattern": "^class\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sex": {
      "description": "The body variant this option renders with. It is a property of the option, not a customization axis: ADR 0032 section 4 gives M2 no appearance data model, and every character of an option renders identically.",
      "enum": ["female", "male"]
    },
    "faction": {
      "description": "Canonical faction id, resolved against a faction document.",
      "type": "string",
      "pattern": "^faction\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "enabled": {
      "description": "Whether the client may offer this option. This is how \"one playable option in M2\" is expressed.",
      "type": "boolean"
    },
    "loc_ref": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/locKey" },
        "description": { "$ref": "common.schema.json#/$defs/locKey" }
      }
    },
    "visual_ref": {
      "description": "The model and material every character of this option renders with.",
      "type": "string",
      "minLength": 1
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone_id", "position", "heading"],
      "properties": {
        "zone_id": { "$ref": "common.schema.json#/$defs/zoneId" },
        "position": { "$ref": "common.schema.json#/$defs/position" },
        "heading": { "type": "number" }
      }
    },
    "starting_level": { "type": "integer", "minimum": 1 },
    "starting_stats": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/statEntry" }
    },
    "stats": {
      "description": "Typed first-spawn state and the exact inputs needed to reproduce retail action scalers. Enabled product options must carry this block; the compiler enforces that migration rule.",
      "type": "object",
      "additionalProperties": false,
      "required": ["health", "max_health", "resource", "innate", "armor", "resistances", "hit_dice", "mana_dice", "mainhand", "ranged"],
      "properties": {
        "health": { "type": "integer", "minimum": 1 },
        "max_health": { "type": "integer", "minimum": 1 },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "initial", "maximum"],
          "properties": {
            "kind": { "$ref": "common.schema.json#/$defs/slug" },
            "initial": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
            "maximum": { "$ref": "common.schema.json#/$defs/scriptDecimal" }
          }
        },
        "innate": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactStatEntry" } },
        "armor": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "resistances": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/exactStatEntry" } },
        "hit_dice": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "mana_dice": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "base_stat_value": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "weapon_dps_default": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "fairy_scaler": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "mainhand": { "$ref": "#/$defs/weaponProfile" },
        "ranged": { "$ref": "#/$defs/weaponProfile" }
      }
    },
    "starting_loadout": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "quantity", "slot"],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^item\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "slot": {
            "description": "An equipment slot, or bag for anything not equipped at first spawn.",
            "$ref": "common.schema.json#/$defs/slug"
          }
        }
      }
    },
    "starting_abilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ability(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$"
      }
    },
    "starting_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id"],
        "properties": {
          "slot_index": { "type": "integer", "minimum": 0 },
          "action_id": { "type": "string", "pattern": "^action(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" }
        }
      }
    },
    "passive_ability_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^passive(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$" }
    },
    "starting_quests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^quest(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*){2,}$"
      }
    },
    "extra": { "type": "object", "additionalProperties": true },
    "curation_note": { "$ref": "common.schema.json#/$defs/curationNote" },
    "_source": { "$ref": "common.schema.json#/$defs/source" }
  },
  "$defs": {
    "weaponProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_damage", "maximum_damage", "speed_ms"],
      "properties": {
        "minimum_damage": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "maximum_damage": { "$ref": "common.schema.json#/$defs/scriptDecimal" },
        "speed_ms": { "$ref": "common.schema.json#/$defs/scriptDecimal" }
      }
    }
  }
}
